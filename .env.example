# Copy to .env.local for local overrides. Nothing here is required to run the
# site — every value has a working fallback.

# Canonical origin for OG tags, canonical links and sitemap.xml.
# Leave unset on Vercel until a custom domain is attached: the build falls back
# to VERCEL_PROJECT_PRODUCTION_URL, which Vercel injects automatically.
# NEXT_PUBLIC_SITE_URL=https://abhishekjoshi.dev

# Downgrades the placeholder-content build guard from an error to a warning.
# Useful for a first deploy while copy is still being written.
# ALLOW_PLACEHOLDER_CONTENT=1
